<% layout("layouts/boilerplate") %>
<div class="row mt-3">
  <!-- <h1 class="col-6 offset-4">Welcome to Havenly</h1> -->
  <div class="col-sm-8 col-md-6 offset-ms-2 offset-md-3 offset-lg-4">
    <form
      action="/signup"
      method="post"
      class="needs-validation signup-form"
      novalidate
    >
      <h1>Sign Up</h1>
      <div>
        <label for="username" class="form-label">Username:</label>
        <input
          type="text"
          id="username"
          class="form-control"
          name="username"
          required
        />
      </div>
      <div>
        <label for="email" class="form-label">Email:</label>
        <input
          type="email"
          id="email"
          class="form-control"
          name="email"
          required
        />
      </div>
      <div>
        <label for="password" class="form-label">Password:</label>
        <input
          type="password"
          id="password"
          class="form-control"
          name="password"
          required
        />
      </div>

      <button class="btn btn-success mb-2 mt-2">Sign Up</button>
      <p>Already have account ? Try <a href="/login">Login</a></p>
    </form>
  </div>
</div>
