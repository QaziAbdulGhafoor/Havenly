<% layout("layouts/boilerplate") %>
<div class="row mt-3">
  <div class="col-md-6 offset-md-4">
    <form
      action="/login"
      method="post"
      class="needs-validation signup-form"
      novalidate
    >
      <h1>Login</h1>
      <div>
        <label for="username" class="form-label">Username:</label>
        <input
          type="text"
          id="username"
          class="form-control"
          name="username"
          required
        />
      </div>
      <div>
        <label for="password" class="form-label">Password:</label>
        <input
          type="password"
          id="password"
          class="form-control"
          name="password"
          required
        />
      </div>
      <button class="btn btn-success mb-2 mt-2">Login</button>
      <p>New Here? Try <a href="/signup">Signup</a></p>
    </form>
  </div>
</div>
