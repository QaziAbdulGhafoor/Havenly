<% layout("layouts/boilerplate") %>
<h1 id="new-head">Edit Your Listing</h1>
<form
  class="row g-3 needs-validation listing-form"
  novalidate
  method="post"
  action="/listings/<%= Mylisting._id %>?_method=PUT"
  enctype="multipart/form-data"
>
  <div class="col-md-8 mb-1">
    <label for="inputEmail4" class="form-label">Edit listing title:</label>
    <input
      type="text"
      class="form-control"
      id="inputEmail4"
      placeholder="Enter a listing name"
      name="listing[title]"
      value="<%= Mylisting.title %>"
      required
    />
    <div class="valid-feedback">Title Looks good!</div>
    <div class="invalid-feedback">Invalid listing name</div>
  </div>
  <div class="col-md-4 mb-1">
    <label for="floatingSelect" class="form-label"
      >Select Listing Category:</label
    >
    <select class="form-control" id="floatingSelect" name="listing[category]">
      <option value="house">House</option>
      <option value="apartment">Apartment</option>
      <option value="mountain">Mountains</option>
      <option value="river side">River Side</option>
      <option value="luxury">Luxury</option>
    </select>
  </div>
  <!-- <div class="col-6">
    Already Image <br /><img src="<%= originalImage %>" alt="" />
  </div> -->
  <div class="col-8 mb-1">
    <label for="image" class="form-label">Enter Image Link:</label>
    <input type="file" class="form-control" id="image" name="listing[image]" />
    <div class="valid-feedback">Image Looks good!</div>
    <div class="invalid-feedback">Invalid image link</div>
  </div>
  <div class="col-4 mb-1">
    <label for="inputState" class="form-label">Price:</label>
    <input
      type="number"
      id="inputState"
      class="form-control"
      placeholder="Enter a reasonable price"
      name="listing[price]"
      value="<%= Mylisting.price %>"
      required
    />
    <div class="valid-feedback">Price Looks good!</div>
    <div class="invalid-feedback">Invalid price</div>
  </div>
  <div class="col-12 mb-1">
    <label for="inputAddress" class="form-label">Edit Description:</label>
    <textarea
      class="form-control"
      id="inputAddress"
      placeholder="This place is ...."
      name="listing[description]"
      required
    >
<%= Mylisting.description %></textarea
    >
    <div class="valid-feedback">Description Looks good!</div>
    <div class="invalid-feedback">Invalid description</div>
  </div>
  <div class="col-md-6 mb-1">
    <!-- <label for="inputCity" class="form-label">Country:</label> -->
    <input
      type="text"
      class="form-control"
      placeholder="Enter country name e.g India"
      value="<%= Mylisting.country %>"
      name="listing[country]"
      required
      hidden
    />
    <div class="valid-feedback">Country is Valid</div>
    <div class="invalid-feedback">Invalid country name</div>
  </div>
  <div class="col-md-6 mb-1">
    <!-- <label for="inputAddress2" class="form-label">Address/Location:</label> -->
    <input
      type="text"
      class="form-control"
      id="inputAddress2"
      placeholder="detailed location"
      name="listing[location]"
      value="<%= Mylisting.location %>"
      required
      hidden
    />
    <div class="valid-feedback">Address Looks good!</div>
    <div class="invalid-feedback">Invalid address</div>
  </div>

  <div class="col-12 mb-2">
    <button type="submit" class="btn btn-success add">Confirm</button>
  </div>
</form>
