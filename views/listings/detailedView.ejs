<% layout("layouts/boilerplate") %>


  <h2 class="text-center mb-4 mt-2">
    <%= listing.title %>
  </h2>

  <!-- Listing Card -->
  <div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
      <div class="card detail-card mb-4">
        <img
          src="<%= listing.image.url ? listing.image.url : listing.image %>"
          class="card-img-top"
          alt="listing image"
        />

        <div class="card-body">
          <h5 class="card-title"><%= listing.title %></h5>
          <p class="card-text"><%= listing.description %></p>
        </div>

        <ul class="list-group list-group-flush">
          <li class="list-group-item">
            <b>Country:</b> <%= listing.country %>
          </li>
          <li class="list-group-item">
            <b>Location:</b> <%= listing.location %>
          </li>
          <li class="list-group-item">
            <b>Price:</b> Rs/ <%= listing.price.toLocaleString("en-PK") %>
          </li>
          <li class="list-group-item">
            <b>Owner:</b> <%= listing.owner.username %>
          </li>
        </ul>
        <% if (user && user._id.equals(listing.owner._id)) { %>
          <div class="card-body d-flex gap-2">
          <a
            href="/listings/<%= listing._id %>/edit"
            class="btn btn-success"
          >
            Edit
          </a>

          <form
            action="/listings/<%= listing._id %>?_method=DELETE"
            method="POST"
          >
            <button class="btn btn-danger">Delete</button>
          </form>
          </div>
           <%  } %>
          
      </div>
    </div>
  </div>

  <!-- Review Form -->
  <div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
      <% if(user){ %>
      <h1>Leave A Review</h1>
      <form
        action="/listings/<%= listing._id %>/reviews"
        method="POST"
        class="mb-4"
      >
        <div class="mb-3">
           <fieldset class="starability-slot">
  <legend>Ratings:</legend>
  <input type="radio" id="first-rate5" name="review[ratings]" value="5" />
  <label for="first-rate5" title="Amazing">5 stars</label>
  <input type="radio" id="first-rate4" name="review[ratings]" value="4" />
  <label for="first-rate4" title="Very good">4 stars</label>
  <input type="radio" id="first-rate3" name="review[ratings]" value="3" />
  <label for="first-rate3" title="Average">3 stars</label>
  <input type="radio" id="first-rate2" name="review[ratings]" value="2" />
  <label for="first-rate2" title="Not good">2 stars</label>
  <input type="radio" id="first-rate1" name="review[ratings]" value="1" />
  <label for="first-rate1" title="Terrible">1 star</label>
</fieldset>
          <!-- <input
            type="range"
            id="rating"
            min="1"
            max="5"
            name="review[ratings]"
            class="form-range"
            oninput="this.nextElementSibling.value = this.value"
          />
          <output>3</output> -->
        </div>
         
        <div class="mb-3">
          <label for="comment" class="form-label">
            Enter your comment:
          </label>
          <textarea
            name="review[comment]"
            rows="3"
            id="comment"
            class="form-control"
          ></textarea>
        </div>
        <button class="btn btn-success">Add Review</button>
      </form>
      <% } %>
    </div>
  </div>

  <!-- Reviews Section -->
  <div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
      <h4 class="mb-3">All Reviews</h4>

      <div class="row">
        <% if (listing.reviews && listing.reviews.length > 0) { %>
          <% listing.reviews.forEach(function(review) { %>

            <div class="col-md-6 mb-3">
              <div class="card review">
                <div class="card-body">
                  <div class="d-flex justify-content-between">
                    <h5 class="mb-1"><%= review.author.username %></h5>
                  </div>
                  <p class="mt-2 mb-0">
                    <%= review.comment %>
                  </p>
                    <p class="starability-result" id="rev-stars"data-rating="<%= review.ratings %>">
                      Rated: 3 stars
                    </p>
                  <% if(review.author._id.equals(user._id)){ %>
                  <form action="/listings/<%=listing.id%>/reviews/<%=review.id%>?_method=DELETE" method="post"><button class="btn btn-outline-dark mt-1">Delete</button></form>
                  <% } %>
               </div>
              </div>
            </div>

          <% }) %>
        <% } else { %>
          <p>No reviews yet</p>
        <% } %>
      </div>
    </div>
  </div>
  
  <div class="col-md-8 col-lg-6 offset-3">
  <div
  id="map"
  data-coordinates='<%- JSON.stringify(listing.geometry.coordinates) %>'
  ></div>
  </div>
  
<% if(listing.geometry){ %>
  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script>
  const mapDiv = document.getElementById("map");

  const coordinates = JSON.parse(
    mapDiv.dataset.coordinates
  );

  const lon = coordinates[0];
  const lat = coordinates[1];

  const map = L.map("map").setView([lat, lon], 13);

  L.tileLayer(
    "https://tile.openstreetmap.org/{z}/{x}/{y}.png",
    {
      attribution: "&copy; OpenStreetMap contributors",
    }
  ).addTo(map);

  L.marker([lat, lon])
    .addTo(map)
    .bindPopup("Listing Location");
</script>

<% } %>