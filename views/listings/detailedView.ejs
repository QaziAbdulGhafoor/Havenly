<% layout("layouts/boilerplate") %>


  
  <!-- redefined card -->
   <div class="detailedcard">
    <div class="sideimg">
    <img src="<%= listing.image.url ? listing.image.url : listing.image %>" alt="">
    </div>
    <% if (user && user._id.equals(listing.owner._id)) { %>
  <div class="options">
    <a href="/listings/<%= listing._id %>/edit" class="btn btn-success">
      Edit Listing
    </a>
    <form action="/listings/<%= listing._id %>?_method=DELETE" method="POST">
      <button class="btn btn-danger">Delete Listing</button>
    </form>
  </div>

<% } else if (user) { %>
  <div class="options">
    <% if (isFavourite) { %>
      <form action="/listings/<%= listing._id %>/favourites?_method=DELETE" method="POST">
        <button class="btn btn-danger">♥ Remove from Favourites</button>
      </form>
    <% } else { %>
      <form action="/listings/<%= listing._id %>/favourites" method="POST">
        <button class="btn btn-success">♡ Add to Favourites</button>
      </form>
    <% } %>
  </div>

<% } %>
      <div class="headings"><h1 ><%= listing.title %></h1>
    <p ><i class="fa-solid fa-location-dot"></i><%= listing.location %> , <%= listing.country %></p></div>
    <div class="descriptions">
      <h4 >About this place</h4>
    <p ><%= listing.description %></p>
    </div>
    <div class="all-info">
    
      <div class="info-box">
         <span><i class="fa-solid fa-globe"></i></span>
        <p>Country <br><%= listing.country %></p>
      </div>
      <div class="info-box">
         <span><i class="fa-solid fa-tag"></i></span>
        <p>Price <br><%= listing.price %>$/night</p>
      </div>
    </div>
    <div class="owner">
      <div class="profile-pic"><img src="/shortlogo.png" alt=""></div>
      <div class="other-details"><h4>Hosted By:</h4>
      <p><%= listing.owner.username %></p>
      <p><%= listing.reviews.length %> reviews</p>
    </div>
    </div>
   </div>
